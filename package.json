{
  "name": "jonobones",
  "version": "0.1.4",
  "description": "A headless, Joplin-sync-compatible knowledge daemon",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ParkviewLab/jonobones.git"
  },
  "homepage": "https://github.com/ParkviewLab/jonobones#readme",
  "bugs": {
    "url": "https://github.com/ParkviewLab/jonobones/issues"
  },
  "keywords": [
    "joplin",
    "sync",
    "headless",
    "daemon",
    "knowledge-base",
    "rest-api"
  ],
  "bin": {
    "jonobones": "bin/jonobones.js"
  },
  "files": [
    "bin/",
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "spike": "node spike/lib-spike.mjs run",
    "test:interop": "vitest run tests/interop",
    "test:e2e": "npm run build && vitest run --config vitest.e2e.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@fastify/multipart": "^10.0.0",
    "@joplin/lib": "3.6.3",
    "fastify": "^5.8.5",
    "json5": "^2.2.3",
    "sqlite3": "5.1.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.9.3",
    "eslint": "^10.4.1",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  }
}
